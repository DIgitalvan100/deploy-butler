{
  "exported_by": "deploy-butler",
  "version": 1,
  "name": "myapp",
  "updates_dir": "/home/me/Updates",
  "update_format": "folder",
  "ssh_host": "203.0.113.10",
  "ssh_port": 22,
  "ssh_user": "deploy",
  "ssh_key_path": "/home/me/.ssh/id_ed25519",
  "app_dir": "/opt/myapp/app",
  "service_type": "systemd",
  "service_name": "myapp",
  "app_owner": "myapp:myapp",
  "backups_dir": "/var/backups/deploy-butler/myapp",
  "db_backup_paths": ["/var/lib/myapp/app.db"],
  "healthcheck_url": "https://app.example/health",
  "expected_codes": [200, 301, 302],
  "expected_text": "ok",
  "log_error_patterns": ["Error", "TypeError", "ReferenceError", "SyntaxError", "Unhandled", "EADDRINUSE"],
  "forbidden_patterns": ["*.env", ".env*", "*.db", "*.sqlite", "*.pem", "*.key", "id_rsa*", "node_modules/", ".git/", "*-test.js", "test-*", "seed-*"],
  "deploy_mode": "inplace",
  "unreachable_hint": "Сервер недоступен. Проверьте интернет/VPN/ключ"
}
